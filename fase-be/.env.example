PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fase
# true: TypeORM tự tạo/cập nhật bảng theo entity (giống ReviseHOU). Production nên tắt và dùng migration.
DB_SYNCHRONIZE=true

SECRET_KEY=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
SESSION_SECRET=change-me-session-secret

# Fase-Sales (React) chạy ở đâu, cách nhau dấu phẩy
FRONTEND_URL=http://localhost:5173

# Giờ hành chính tính hạn nhận LEAD 2h (BR-01). 0=CN, 1=T2 ... 6=T7
BUSINESS_DAYS=1,2,3,4,5
BUSINESS_HOURS=08:00-12:00,13:30-17:30
# Ngày nghỉ lễ YYYY-MM-DD, cách nhau dấu phẩy
HOLIDAYS=
BUSINESS_UTC_OFFSET_MINUTES=420

# Đặt false để tắt job nền (vd. khi chạy nhiều instance mà chỉ muốn 1 instance chạy job)
SCHEDULER_ENABLED=true
