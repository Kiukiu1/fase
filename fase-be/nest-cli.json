{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "cms/view/**/*", "watchAssets": true },
      { "include": "cms/static/**/*", "watchAssets": true }
    ]
  }
}
